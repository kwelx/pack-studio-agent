# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Local development uses PGlite at data/pglite when DATABASE_URL is unset.
# Production, including Cloudflare Workers, needs a hosted Postgres URL.
# DATABASE_URL=postgres://user:pass@host:5432/pack_studio

# Optional. The proof desk works without a model key. Agent chat needs one.
# Set it in the host's secret store, not in git.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
